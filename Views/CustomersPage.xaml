<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InvoiceDigitizationApp.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="العملاء والموردون" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="الأسماء البديلة هنا هي ما تُطابَق أسماء العملاء والموردين المستخرَجة ضوئيًا معها."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" PlaceholderText="ابحث بالاسم أو الاسم البديل…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="بحث" Command="{x:Bind ViewModel.SearchCommand}" />
            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                    Content="سجل جديد" Command="{x:Bind ViewModel.NewCustomerCommand}" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Contacts -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                    <controls:DataGrid
                        AutoGenerateColumns="False" IsReadOnly="True"
                        GridLinesVisibility="Horizontal" SelectionMode="Single"
                        ItemsSource="{x:Bind ViewModel.Customers}"
                        SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="المعرّف" Width="60" Binding="{Binding CustomerId}" />
                            <controls:DataGridTextColumn Header="الاسم" Width="*" Binding="{Binding Name}" />
                            <controls:DataGridTextColumn Header="الاسم البديل" Width="*" Binding="{Binding AliasName}" />
                            <controls:DataGridTextColumn Header="المدينة" Width="120" Binding="{Binding City}" />
                            <controls:DataGridTextColumn Header="الهاتف" Width="130" Binding="{Binding Phone}" />
                            <controls:DataGridTextColumn Header="النوع" Width="110" Binding="{Binding CustomerType, Converter={StaticResource EnumDisplay}}" />
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Border>

                <!-- Invoices for the selected contact -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="الفواتير المرتبطة" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                       Text="{x:Bind LinkedTotalLabel(ViewModel.LinkedInvoiceTotal), Mode=OneWay}" />
                        </Grid>

                        <controls:DataGrid
                            Grid.Row="1"
                            AutoGenerateColumns="False" IsReadOnly="True"
                            GridLinesVisibility="Horizontal"
                            ItemsSource="{x:Bind ViewModel.LinkedInvoices}">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="المعرّف" Width="60" Binding="{Binding InvoiceId}" />
                                <controls:DataGridTextColumn Header="رقم الفاتورة" Width="130" Binding="{Binding InvoiceNumber}" />
                                <controls:DataGridTextColumn Header="التاريخ" Width="110" Binding="{Binding InvoiceDate}" />
                                <controls:DataGridTextColumn Header="النوع" Width="100" Binding="{Binding InvoiceType, Converter={StaticResource EnumDisplay}}" />
                                <controls:DataGridTextColumn Header="الإجمالي" Width="*" Binding="{Binding TotalAmount}" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Editor -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Width="300" VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <TextBox Header="الاسم"
                             Text="{x:Bind ViewModel.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Header="الاسم البديل على الفواتير"
                             PlaceholderText="الاسم كما يُطبع على الورق"
                             Text="{x:Bind ViewModel.EditAliasName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Header="المدينة"
                             Text="{x:Bind ViewModel.EditCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Header="الهاتف" Style="{StaticResource NumericBoxStyle}"
                             Text="{x:Bind ViewModel.EditPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox Header="النوع" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.CustomerTypeOptions}"
                              SelectedItem="{x:Bind ViewModel.EditCustomerType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind Converter={StaticResource EnumDisplay}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="حفظ" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveCommand}" />
                        <Button Content="إلغاء" Command="{x:Bind ViewModel.CancelEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="تعديل" Command="{x:Bind ViewModel.EditCustomerCommand}" />
            <Button Grid.Column="1" Content="حذف" Click="Delete_Click" />

            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
