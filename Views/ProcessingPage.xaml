<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InvoiceDigitizationApp.Views.ProcessingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:vm="using:InvoiceDigitizationApp.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title. Matches the navigation item's wording so the two name one screen. -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="مراجعة الفواتير" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="راجع البيانات المستخرجة مقارنة بالأصل قبل الحفظ."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!--
          Toolbar.

          IsEnabled hangs off the whole bar rather than each button: a disabled parent
          wins over a child's own enabled state, so the ICommand machinery — which writes
          IsEnabled directly whenever CanExecute changes — cannot re-enable a button in
          the middle of a batch. Every one of these commands runs through RunGuardedAsync,
          which refuses to start while another is running and says nothing about it; the
          greyed-out bar is that refusal made visible.
        -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left"
                    Background="Transparent" IsOpen="False"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
            <AppBarButton Icon="OpenFile" Label="فتح ملف" Click="OpenFile_Click" />
            <AppBarSeparator />

            <AppBarButton Icon="Repair" Label="التحقق"
                          Command="{x:Bind ViewModel.ValidateCommand}" />
            <AppBarButton Icon="Calculator" Label="تصحيح إجماليات البنود"
                          Command="{x:Bind ViewModel.FixLineTotalsCommand}" />
            <AppBarSeparator />

            <AppBarButton Icon="Save" Label="حفظ"
                          Command="{x:Bind ViewModel.SaveCommand}" />
            <AppBarButton Icon="Download" Label="تصدير">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Excel (.xlsx)"
                                        Command="{x:Bind ViewModel.ExportCommand}"
                                        CommandParameter="excel" />
                        <MenuFlyoutItem Text="CSV (.csv)"
                                        Command="{x:Bind ViewModel.ExportCommand}"
                                        CommandParameter="csv" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <CommandBar.SecondaryCommands>
                <AppBarToggleButton Label="إظهار لوحة النموذج"
                                    IsChecked="{x:Bind ViewModel.IsFormPaneVisible, Mode=TwoWay}" />
                <AppBarToggleButton Label="إظهار لوحة الصورة"
                                    IsChecked="{x:Bind ViewModel.IsImagePaneVisible, Mode=TwoWay}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!--
          Batch bar. Present only while an import is under review; a single file is a
          batch of one and shows it too, so there is one path to reason about.

          The navigation buttons are worded, not iconographic. A FontIcon arrow keeps its
          glyph under FlowDirection=RightToLeft — the layout mirrors but the drawing does
          not — so "next" would point backwards on this screen.
        -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="12,8"
                Visibility="{x:Bind ViewModel.IsBatchActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{x:Bind ViewModel.BatchPositionLabel, Mode=OneWay}" />

                <!--
                  Grouped so the batch's own guarded commands grey out together while the
                  extraction loop holds the busy flag, leaving only cancel reachable.

                  The group is a ContentControl and not the bare StackPanel it wraps
                  because IsEnabled is declared on Control, not on UIElement as it is in
                  WPF — a panel simply has no such property here, and binding one on it
                  fails the XAML compile.
                -->
                <ContentControl Grid.Column="1" VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="السابق"
                                Command="{x:Bind ViewModel.PreviousBatchItemCommand}" />
                        <Button Content="تخطّي"
                                Command="{x:Bind ViewModel.SkipBatchItemCommand}"
                                ToolTipService.ToolTip="تجاهل هذه الفاتورة وحذف صورها" />
                        <Button Content="التالي"
                                Command="{x:Bind ViewModel.NextBatchItemCommand}" />
                    </StackPanel>
                </ContentControl>

                <!--
                  Indeterminate while the extraction loop is still walking the list — the
                  service reports which file it is on through the status line, not a
                  count this bar could fill. Once processing ends it settles into review
                  progress: how many of the batch have been saved or skipped.
                -->
                <ProgressBar Grid.Column="2" VerticalAlignment="Center"
                             Minimum="0"
                             Maximum="{x:Bind ViewModel.BatchTotalCount, Mode=OneWay}"
                             Value="{x:Bind ViewModel.BatchReviewedCount, Mode=OneWay}"
                             IsIndeterminate="{x:Bind ViewModel.IsBatchProcessing, Mode=OneWay}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <!--
                      Deliberately outside the IsNotBusy group: the busy flag stays set for
                      the whole batch, so gating cancel on it would disable the one button
                      that exists to end that state.
                    -->
                    <Button Content="إلغاء المعالجة"
                            Command="{x:Bind ViewModel.CancelBatchCommand}"
                            Visibility="{x:Bind ViewModel.IsBatchProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="إنهاء الدفعة"
                            Command="{x:Bind ViewModel.EndBatchCommand}"
                            ToolTipService.ToolTip="إنهاء المراجعة وحذف صور ما لم يُحفظ"
                            Visibility="{x:Bind ViewModel.IsBatchProcessing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Validation summary -->
        <InfoBar
            Grid.Row="3"
            IsOpen="{x:Bind ViewModel.HasValidationMessages, Mode=OneWay}"
            Severity="Warning"
            IsClosable="False"
            Title="تحقق من هذه العناصر قبل الحفظ">
            <InfoBar.Content>
                <ItemsControl ItemsSource="{x:Bind ViewModel.ValidationMessages}" Margin="0,4,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </InfoBar.Content>
        </InfoBar>

        <!-- Split view: form on one side, the invoice image on the other -->
        <Grid Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Left: editable data -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsFormPaneVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header fields -->
                    <Grid Grid.Row="0" ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                          The counterparty is chosen, never typed: an invoice always belongs
                          to a row of the Customers table, and this picker is the only way
                          to set it. Matching accepts the record's name or its alias.

                          Header and placeholder follow the invoice type — the same record
                          is "المورد" on a purchase and "العميل" on a sale — and read from
                          the ViewModel so this screen and the validation messages always
                          use the one word.
                        -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                            <ComboBox HorizontalAlignment="Stretch"
                                      Header="{x:Bind ViewModel.CounterpartyLabel, Mode=OneWay}"
                                      PlaceholderText="{x:Bind ViewModel.CounterpartyPlaceholder, Mode=OneWay}"
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{x:Bind ViewModel.CustomerChoices}"
                                      SelectedItem="{x:Bind ViewModel.SelectedCustomerChoice, Mode=TwoWay}" />

                            <!--
                              The list is ordered by how well each contact matched the
                              letterhead, best first with its score, so confirming a
                              correct read is one glance and correcting a wrong one is
                              one click rather than a scroll through the whole table.
                            -->
                            <TextBlock Text="{x:Bind ViewModel.MerchantReviewText, Mode=OneWay}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       Visibility="{x:Bind ViewModel.MerchantNeedsReview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- The number printed on the invoice itself, not the database id. -->
                        <TextBox Grid.Row="0" Grid.Column="1" Header="رقم الفاتورة المطبوع"
                                 Text="{x:Bind ViewModel.InvoiceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--
                          One-way and read-only. The city belongs to the counterparty's
                          record: it is filled in when one is chosen and saved onto the
                          invoice as a snapshot. Editing it here would produce an invoice
                          whose city disagrees with the record it points at.
                        -->
                        <TextBox Grid.Row="1" Grid.Column="0" Header="المدينة"
                                 IsReadOnly="True" Opacity="0.75"
                                 PlaceholderText="—"
                                 ToolTipService.ToolTip="تُؤخذ من سجل العميل/المورد ولا تُحرَّر هنا"
                                 Text="{x:Bind ViewModel.City, Mode=OneWay}" />

                        <DatePicker Grid.Row="1" Grid.Column="1" Header="تاريخ الفاتورة"
                                    HorizontalAlignment="Stretch"
                                    SelectedDate="{x:Bind ViewModel.InvoiceDate, Mode=TwoWay}" />

                        <ComboBox Grid.Row="2" Grid.Column="0" Header="النوع"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.InvoiceTypeOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedInvoiceType, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Header="إجمالي الفاتورة"
                                     Style="{StaticResource NumericBoxStyle}"
                                     Text="{x:Bind ViewModel.TotalAmount, Mode=TwoWay, Converter={StaticResource Money}, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="1" VerticalAlignment="Bottom"
                                    Content="مجموع البنود"
                                    ToolTipService.ToolTip="استخدام مجموع البنود كإجمالي للفاتورة"
                                    Command="{x:Bind ViewModel.UseComputedTotalCommand}" />
                        </Grid>
                    </Grid>

                    <!--
                      Line items.

                      Every column is a template column holding a live editor, and the
                      grid itself is read-only. That is deliberate: the DataGrid's own
                      edit mode commits a cell only on a successful string→value
                      conversion at commit time, which is what silently dropped edits to
                      the decimal columns. Binding the editors directly means each change
                      lands on the row ViewModel the moment the control commits it.
                    -->
                    <controls:DataGrid
                        Grid.Row="1"
                        x:Name="ItemsGrid"
                        AutoGenerateColumns="False"
                        CanUserSortColumns="False"
                        IsReadOnly="True"
                        GridLinesVisibility="All"
                        HeadersVisibility="Column"
                        RowHeight="48"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        RowBackground="Transparent"
                        LoadingRow="ItemsGrid_LoadingRow">

                        <controls:DataGrid.Columns>
                            <!--
                              Products come from the catalog only. There is no free-text
                              path here: anything the invoice mentions that is not in the
                              Products table has to be added there first, via the button
                              under the grid.

                              The list is ordered by how well each product matched what
                              was read on this line — best first, with its similarity
                              score — so the right product is normally already selected
                              and confirming it costs nothing.
                            -->
                            <controls:DataGridTemplateColumn Header="المنتج" Width="2*">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:InvoiceItemRowViewModel">
                                        <ComboBox Margin="4,2"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="اختر منتجًا"
                                                  DisplayMemberPath="DisplayName"
                                                  ItemsSource="{x:Bind ProductChoices}"
                                                  SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!-- What OCR read, so an unmatched row can still be identified. -->
                            <controls:DataGridTemplateColumn Header="نص الفاتورة" Width="140">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:InvoiceItemRowViewModel">
                                        <StackPanel Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DetectedProductName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind DetectedProductName}" />
                                            <TextBlock Text="{x:Bind ProductStatusHint, Mode=OneWay}"
                                                       FontSize="11" Opacity="0.8"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                       Visibility="{x:Bind ProductStatusHint, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <controls:DataGridTemplateColumn Header="الكمية" Width="110">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:InvoiceItemRowViewModel">
                                        <NumberBox Margin="4,2" Minimum="0"
                                                   SpinButtonPlacementMode="Hidden"
                                                   FlowDirection="LeftToRight"
                                                   Value="{x:Bind Quantity, Mode=TwoWay, Converter={StaticResource DecimalToDouble}}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <controls:DataGridTemplateColumn Header="سعر الوحدة" Width="130">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:InvoiceItemRowViewModel">
                                        <NumberBox Margin="4,2" Minimum="0"
                                                   SpinButtonPlacementMode="Hidden"
                                                   FlowDirection="LeftToRight"
                                                   Value="{x:Bind UnitPrice, Mode=TwoWay, Converter={StaticResource DecimalToDouble}}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!--
                              Editable, but normally derived: changing the quantity or the
                              unit price rewrites this, and typing here is an override.
                            -->
                            <controls:DataGridTemplateColumn Header="إجمالي البند" Width="130">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:InvoiceItemRowViewModel">
                                        <NumberBox Margin="4,2"
                                                   SpinButtonPlacementMode="Hidden"
                                                   FlowDirection="LeftToRight"
                                                   Value="{x:Bind TotalPrice, Mode=TwoWay, Converter={StaticResource DecimalToDouble}}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!-- Shows the expected value on rows that fail the check. -->
                            <controls:DataGridTemplateColumn Header="" Width="110">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:InvoiceItemRowViewModel">
                                        <TextBlock Margin="8,0" VerticalAlignment="Center"
                                                   FontSize="12" Opacity="0.85"
                                                   Text="{x:Bind ArithmeticHint, Mode=OneWay}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <controls:DataGridTemplateColumn Header="ملاحظات" Width="*">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:InvoiceItemRowViewModel">
                                        <TextBox Margin="4,2" BorderThickness="0"
                                                 Background="Transparent"
                                                 Text="{x:Bind Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <!-- Row actions + grand total -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.HasUnlinkedRows, Mode=OneWay}"
                            Severity="Warning" IsClosable="False"
                            Title="بنود غير مرتبطة"
                            Message="{x:Bind ViewModel.UnlinkedRowsText, Mode=OneWay}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- ContentControl for the same reason as the batch bar's group. -->
                            <ContentControl Grid.Column="0"
                                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="إضافة صف"
                                            Command="{x:Bind ViewModel.AddItemCommand}" />
                                    <Button Content="حذف صف" Click="RemoveRow_Click" />

                                    <!--
                                      The sanctioned route for a product the invoice
                                      mentions but the catalog does not have: register
                                      it, then link the row.
                                    -->
                                    <Button Content="إضافة المنتج المحدد إلى قائمة المنتجات"
                                            Click="AddProductToCatalog_Click" />
                                </StackPanel>
                            </ContentControl>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="15"
                                       Text="{x:Bind ViewModel.TotalComparisonText, Mode=OneWay}"
                                       Foreground="{x:Bind TotalBrush(ViewModel.TotalsDisagree), Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Splitter -->
            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Right: the invoice image, in whichever of the three renderings is picked -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0"
                    Visibility="{x:Bind ViewModel.IsImagePaneVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                      Rendering picker.

                      Three separate RadioButtons sharing a GroupName rather than a
                      RadioButtons container: the container assigns its own grouping and
                      realizes its children lazily, which leaves an x:Bind selection
                      arriving before the items exist with nothing to select. Individual
                      buttons bind one-way to the ViewModel's choice and push the change
                      back through Checked, and they lay out right-to-left with the rest
                      of the page.

                      A rendering the service did not return is disabled rather than
                      hidden, so the set of three stays in the same place every time.
                    -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="8,8,8,0">
                        <RadioButton GroupName="InvoiceImageViews"
                                     Content="الأصلية"
                                     ToolTipService.ToolTip="الصورة كما استوردتها"
                                     IsEnabled="{x:Bind ViewModel.HasOriginalImage, Mode=OneWay}"
                                     IsChecked="{x:Bind IsOriginalView(ViewModel.SelectedImageView), Mode=OneWay}"
                                     Checked="OriginalView_Checked" />

                        <RadioButton GroupName="InvoiceImageViews"
                                     Content="المحسّنة"
                                     ToolTipService.ToolTip="بعد تحسين الإضاءة والتباين"
                                     IsEnabled="{x:Bind ViewModel.HasEnhancedImage, Mode=OneWay}"
                                     IsChecked="{x:Bind IsEnhancedView(ViewModel.SelectedImageView), Mode=OneWay}"
                                     Checked="EnhancedView_Checked" />

                        <RadioButton GroupName="InvoiceImageViews"
                                     Content="قراءة OCR"
                                     ToolTipService.ToolTip="الصورة كما قرأها محرك التعرّف على النص"
                                     IsEnabled="{x:Bind ViewModel.HasOcrImage, Mode=OneWay}"
                                     IsChecked="{x:Bind IsOcrView(ViewModel.SelectedImageView), Mode=OneWay}"
                                     Checked="OcrView_Checked" />
                    </StackPanel>

                    <!-- Zoom controls -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Padding="8"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Button Command="{x:Bind ViewModel.ZoomOutCommand}" ToolTipService.ToolTip="تصغير">
                            <FontIcon Glyph="&#xE71F;" FontSize="14" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.ZoomInCommand}" ToolTipService.ToolTip="تكبير">
                            <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.ZoomResetCommand}" Content="ملاءمة" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"
                                   Text="{x:Bind ZoomLabel(ViewModel.ZoomFactor), Mode=OneWay}" />
                    </StackPanel>

                    <!-- Pan + zoom surface -->
                    <ScrollViewer
                        x:Name="ImageScroller"
                        Grid.Row="2"
                        ZoomMode="Enabled"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollMode="Enabled"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        MinZoomFactor="0.1"
                        MaxZoomFactor="8"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

                        <Image x:Name="InvoiceImage" Stretch="Uniform" />
                    </ScrollViewer>

                    <!-- Placeholder before a file is opened -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="8"
                                x:Name="NoImagePlaceholder"
                                Visibility="{x:Bind HasNoImage(ViewModel.CurrentImagePath), Mode=OneWay}">
                        <FontIcon Glyph="&#xE722;" FontSize="40" Opacity="0.35" />
                        <TextBlock Text="لا توجد فاتورة مفتوحة" Opacity="0.7" HorizontalAlignment="Center" />
                        <Button Content="فتح فاتورة…" Click="OpenFile_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="5" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressRing Grid.Column="0" Width="18" Height="18"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="{x:Bind StatusBrush(ViewModel.HasError), Mode=OneWay}" />

            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7"
                       Text="{x:Bind UnsavedLabel(ViewModel.HasUnsavedChanges), Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
