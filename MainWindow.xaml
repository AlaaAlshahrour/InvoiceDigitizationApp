<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="InvoiceDigitizationApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:InvoiceDigitizationApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="نظام رقمنة الفواتير">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
      FlowDirection is RightToLeft app-wide: this is an Arabic-primary product, so the
      navigation pane, form labels and grid columns all read right-to-left. Individual
      numeric fields opt back into LeftToRight via NumericTextStyle.
    -->
    <Grid x:Name="RootGrid" FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Error banner, shown only when an unhandled exception is caught. -->
        <InfoBar
            x:Name="ErrorBanner"
            Grid.Row="0"
            IsOpen="False"
            Severity="Error"
            Title="حدث خطأ ما"
            IsClosable="True" />

        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="Nav_SelectionChanged"
            OpenPaneLength="240">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="الفواتير" Tag="invoices" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="مراجعة الفواتير" Tag="processing">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemSeparator />

                <muxc:NavigationViewItem Content="المنتجات" Tag="products">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="العملاء والموردون" Tag="customers">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="التحليلات" Tag="analytics">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="الإعدادات" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>
