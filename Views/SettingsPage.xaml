<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InvoiceDigitizationApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="820"
                    HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="الإعدادات" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="الاتصال ومواقع التخزين والمظهر."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- AI service -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="خدمة الاستخراج" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="13"
                               Text="خدمة Python المحلية التي تقرأ الفواتير. تعمل على هذا الجهاز فقط ولا تتصل بالإنترنت أبدًا." />

                    <TextBox Header="عنوان URL للخدمة" FlowDirection="LeftToRight"
                             Text="{x:Bind ViewModel.PythonServiceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Header="ملف تنفيذ الخدمة (اختياري)" FlowDirection="LeftToRight"
                             PlaceholderText="اتركه فارغًا إذا كنت تشغّل الخدمة بنفسك"
                             Text="{x:Bind ViewModel.PythonServiceExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="تشغيل الخدمة تلقائيًا مع هذا التطبيق"
                              IsChecked="{x:Bind ViewModel.AutoStartPythonService, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="اختبار الاتصال" Command="{x:Bind ViewModel.TestConnectionCommand}" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{x:Bind ViewModel.ServiceStatus, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Storage -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="التخزين" Style="{StaticResource SectionHeaderStyle}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="مجلد التصدير" FlowDirection="LeftToRight"
                                 Text="{x:Bind ViewModel.ExportDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="استعراض…" VerticalAlignment="Bottom"
                                Click="BrowseExport_Click" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="مجلد صور الفواتير" FlowDirection="LeftToRight"
                                 Text="{x:Bind ViewModel.ImageStorageDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="استعراض…" VerticalAlignment="Bottom"
                                Click="BrowseImages_Click" />
                    </Grid>

                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap" FlowDirection="LeftToRight"
                               Text="{x:Bind DatabaseLabel(ViewModel.DatabasePath)}" />
                </StackPanel>
            </Border>

            <!-- Appearance & review -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="المظهر والمراجعة" Style="{StaticResource SectionHeaderStyle}" />

                    <ComboBox Header="السمة" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind Converter={StaticResource EnumDisplay}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Spacing="4">
                        <TextBlock Text="حد التمييز لمستوى الثقة المنخفض" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="يتم تمييز القيم المستخرَجة التي تقل عن هذا الحد للمراجعة." />
                        <Slider Minimum="0" Maximum="1" StepFrequency="0.05" TickFrequency="0.25"
                                Value="{x:Bind ViewModel.ConfidenceThreshold, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="حفظ الإعدادات" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Content="إعادة التعيين إلى الافتراضي" Click="Reset_Click" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
